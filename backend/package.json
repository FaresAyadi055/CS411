{
  "name": "@app/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names server,studio --prefix-colors blue,green \"bun --watch src/server.ts\" \"bun drizzle-kit studio\"",
    "start": "bun src/server.ts",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:push": "dotenv -e .env -- drizzle-kit push",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:seed": "bun src/db/seed.ts",
    "db:migrate:manual": "bun src/db/migrate.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.14",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@hono/zod-validator": "^0.8.0",
    "@libsql/client": "^0.17.3",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.19",
    "resend": "^6.12.3",
    "ulid": "^3.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.3"
  }
}