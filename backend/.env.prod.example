# --- Server ---
PORT=8787

# --- Public URLs (TEMP: workers.dev) ---
# The frontend is served by a Cloudflare Worker at:
#   https://fidelito-tn.fablabsmu.workers.dev
# That worker PROXIES /api/* to the backend's Cloudflare quick-tunnel URL.
# So the browser only ever talks to workers.dev -> requests hit this backend
# with origin https://fidelito-tn.fablabsmu.workers.dev. Keep these as workers.dev.
FRONTEND_URL=https://fidelito-tn.fablabsmu.workers.dev
CORS_ORIGIN=https://fidelito-tn.fablabsmu.workers.dev
BETTER_AUTH_URL=https://fidelito-tn.fablabsmu.workers.dev

# --- Cookie ---
# Frontend + backend are the SAME origin (workers.dev), so 'strict' is correct.
# (Switch to 'none' only if you later split them onto different registrable domains.)
COOKIE_SAMESITE=strict

# --- Auth secret (generate: openssl rand -base64 32) ---
BETTER_AUTH_SECRET=change-me-min-32-chars-long-secret!!

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM="Fidelito <no-reply@fidelito.tn>"

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@fidelito.tn

# --- Dev toggles (leave unset in prod) ---
# DISABLE_RATE_LIMITING=true
# DISABLE_AUTH=true
