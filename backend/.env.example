# Fidelito backend configuration — OPTIONAL.
# Everything the server needs is hard-coded as a default in src/config/env.ts
# (localhost only, no external services), so the API runs with no .env file at
# all. Only add a file like this to override a default.

# --- Server ---
PORT=8787

# --- Public URLs ---
# Backend origin (CSP connect-src / redirects). Default: http://localhost:8787
BACKEND_URL=http://localhost:8787
# Frontend origin (CORS + redirect URLs). Default: http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed CORS origins. Leave unset in dev: localhost and the
# auto-detected LAN IP are allowed automatically.
#CORS_ORIGIN=http://localhost:5173

# --- Database (local SQLite) ---
# Leave unset: defaults to <repo>/database/app.db
#LOCAL_DB_PATH=file:../database/app.db

# --- Dev toggles ---
DISABLE_RATE_LIMITING=true
DISABLE_AUTH=false

# --- Cookie SameSite ---
# 'strict' (default) when frontend + backend share the same apex domain
COOKIE_SAMESITE=strict
