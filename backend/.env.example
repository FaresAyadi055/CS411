# --- Server ---
PORT=8787

# --- CORS / Origins ---
# Frontend origin (Cloudflare). Used for CORS + redirect URLs.
FRONTEND_URL=https://app.fidelito.tn
# Comma-separated allowed CORS origins. If unset, auto-detects local IP in dev.
CORS_ORIGIN=https://app.fidelito.tn

# --- Auth ---
# Public base URL of THIS backend (used for Better Auth callbacks + cookie `secure` flag).
# Must be https:// in production so the session cookie is set with `secure`.
BETTER_AUTH_URL=https://api.fidelito.tn
BETTER_AUTH_API_KEY=change-me-min-32-chars-long-secret!!

# Cookie note: the session cookie is SameSite=Strict. That works across
# app.fidelito.tn (frontend) -> api.fidelito.tn (backend) because they share the
# same registrable domain. Keep frontend + backend on the SAME apex domain
# (different subdomains are fine). If you put the backend on a完全不同的 domain,
# auth will silently break (cookie never sent) — switch the cookie to SameSite=None
# in src/auth.ts in that case.

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM="Fidelito <no-reply@fidelito.tn>"

# --- Database (local SQLite on VPS) ---
LOCAL_DB_PATH=file:../database/app.db

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@fidelito.tn

# --- Dev toggles ---
# DISABLE_RATE_LIMITING=true   # dev only
# DISABLE_AUTH=true            # dev only

# --- Cookie SameSite ---
# 'strict' (default) when frontend + backend share the same apex domain
# (e.g. app.fidelito.tn + api.fidelito.tn). Use 'none' when the frontend and
# backend are on DIFFERENT registrable domains (e.g. *.workers.dev frontend ->
# *.trycloudflare.com quick-tunnel backend). 'none' REQUIRES https (secure).
# COOKIE_SAMESITE=none
