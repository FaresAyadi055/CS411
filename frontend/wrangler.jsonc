{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fidelito-tn",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "BACKEND_URL": "http://localhost:8787"
  }
}
